# --- Base de données PostgreSQL ---
POSTGRES_USER=copilote_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=copilote_pme
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://copilote_user:change_me@db:5432/copilote_pme

# --- API ---
API_V1_PREFIX=/api/v1
PROJECT_NAME=Copilote IA PME
ENVIRONMENT=development
SECRET_KEY=change_me_super_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Copilote — LLM multi-fournisseur ---
# CHANGER DE FOURNISSEUR = CHANGER DE CLÉ. Collez UNE clé, n'importe laquelle,
# puis redémarrez l'API (Docker : docker compose up -d --force-recreate api).
# Le fournisseur est reconnu au préfixe de la clé :
#   sk-ant-… Anthropic | sk-proj-…/sk-… OpenAI | gsk_… Groq |
#   AQ.…/AIza… Google Gemini | sk-or-… OpenRouter
# La clé peut aller dans sa variable ci-dessous ou dans LLM_API_KEY.
# Sans aucune clé, le copilote répond par synthèse factuelle locale.
# Vérification : bandeau en haut de la page Copilote.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=
#
# --- Réglages facultatifs (à laisser vides en général) ---
# Plusieurs clés renseignées : priorité anthropic > openai > groq > google >
# openrouter, sauf si LLM_PROVIDER en désigne une autre :
# LLM_PROVIDER=google
# Modèle forcé (ignoré s'il n'appartient pas au fournisseur retenu). Défauts :
#   anthropic claude-haiku-5-5 | openai gpt-4o-mini | groq openai/gpt-oss-20b |
#   google gemini-3.6-flash | openrouter openrouter/free
# En cas d'erreur 404 « model not found », indiquer un modèle actuel :
# LLM_MODEL=
# LLM local ou proxy (à vider pour revenir à l'API officielle) — ex. Ollama :
#   OPENAI_API_KEY=ollama  LLM_MODEL=llama3.1  LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL=

# --- Copilote : accès à la base (texte -> SQL en lecture seule) ---
# Actif dès qu'un LLM est configuré ; false pour le désactiver.
COPILOTE_ACCES_BASE=true
# Devise de vos montants (ex. FCFA, €, $). Vide : le copilote n'en affiche aucune.
DEVISE=
# Recommandé : rôle PostgreSQL limité à SELECT (créé par scripts/init_db.sql) :
# COPILOTE_DATABASE_URL_LECTURE=postgresql+psycopg2://copilote_lecture:lecture_change_me@db:5432/copilote_pme
# E-mails des clients lisibles par le copilote (donnée personnelle envoyée au LLM externe) :
COPILOTE_ACCES_EMAILS=false

# --- Fenêtre d'analyse RFM (jours) ---
RFM_ANALYSIS_WINDOW_DAYS=365
