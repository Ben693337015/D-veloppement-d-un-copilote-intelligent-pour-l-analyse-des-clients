# --- Base de données PostgreSQL ---
POSTGRES_USER=copilote_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=copilote_pme
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://copilote_user:change_me@db:5432/copilote_pme

# --- API ---
API_V1_PREFIX=/api/v1
PROJECT_NAME=Copilote IA PME
ENVIRONMENT=development
SECRET_KEY=change_me_super_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Copilote — LLM multi-fournisseur (Phase 5) ---
# TOUS les fournisseurs suivants sont supportés en parallèle ; le premier
# configuré est utilisé automatiquement (ordre de priorité : anthropic >
# openai > groq > google > openrouter), cf. app/services/llm_client.py.
# Ne renseigner QUE le(s) fournisseur(s) que vous comptez utiliser — aucune
# clé n'est requise pour que l'application fonctionne (bascule automatique
# sur un mode local factuel sans LLM).
#
# Pour forcer un fournisseur précis parmi plusieurs clés configurées :
# LLM_PROVIDER=anthropic
# Pour forcer un modèle précis (sinon un modèle rapide/économique par défaut est utilisé) :
# LLM_MODEL=
#
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# Ancien format (une seule clé générique, compatibilité ascendante,
# traitée comme une clé Anthropic si aucune des clés ci-dessus n'est définie) :
LLM_API_KEY=

# --- Fenêtre d'analyse RFM (jours) ---
RFM_ANALYSIS_WINDOW_DAYS=365
